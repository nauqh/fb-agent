# Copy to .env and fill in. .env is gitignored.

# The shared secret every request must carry in `X-API-Key`. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and set the same value here, in Railway's variables, and in web/.env.local.
# Blank denies every request except /health, rather than allowing everything.
# The browser never sees it: web/src/proxy.ts adds it server-side.
API_KEY=

# Supabase Postgres. No local file — a blank value fails on /health rather than
# quietly creating an empty database. Session pooler, port 5432: the transaction
# pooler on 6543 does not support prepared statements, and the direct
# db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Gemini — one model for each call, no fallback chains.
GEMINI_API_KEY=
# Check a model with a real call before setting it here. gemini-2.5-flash was
# this value for one session and answered 404 "no longer available to new users"
# while models.list() still reported it — the catalogue is not evidence.
# When this one rots, gemini-flash-latest is the alias to fall back to.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Tried in order after GEMINI_IMAGE_MODEL when it answers 503/429. Comma-separated;
# empty means no fallback, which is the default — the retry ladder in
# image/hero.py still gives the one model three attempts.
#
# Anything put here is a pinned version and will rot: unlike the text chain,
# which can end on the `gemini-flash-latest` alias, Google publishes no `-latest`
# alias for any image model. The old repo shipped `fix(gemini): replace retired
# image fallback model` once already.
GEMINI_IMAGE_FALLBACK_MODELS=

# Metricool — the only publishing integration. Owns the rival list and the
# page list; we mirror neither (ADR-0001).
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
# true keeps pushes in the planner as drafts. false publishes for real.
METRICOOL_PUBLISH_AS_DRAFT=true

# Supabase Storage — a published composite goes here for Metricool to fetch.
# The bucket must be public: Facebook reads the URL when the post goes out.
#
# One bucket everywhere now. The -dev/-prod split existed because two databases
# handed out the same draft ids, so a laptop run could overwrite a live post's
# image; with one shared Postgres there is one draft 7, and a row written here
# has to resolve from wherever it is read.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fb-agent-media

# X / Twitter — single tweet lookup via api.x.com/2
X_BEARER_TOKEN=
