# Copy to .env and fill in. .env is gitignored.

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Metricool — the only publishing integration. Owns the rival list and the
# page list; we mirror neither (ADR-0001).
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=

# X / Twitter — single tweet lookup via api.x.com/2
X_BEARER_TOKEN=

# Supabase — read-only, and only for the one-off Phase 1 page seed. Delete
# both once pages are seeded; nothing else in this app touches Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
