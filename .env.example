# Copy to .env and fill in. .env is gitignored.

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Tried in order after GEMINI_IMAGE_MODEL when it answers 503/429. Comma-separated;
# empty means no fallback. Keep it disjoint from GEMINI_IMAGE_MODEL — naming the
# same model twice is deduplicated, which leaves you with no fallback at all.
#
# Pinned versions on purpose, and they will rot: unlike the text chain, which can
# end on the `gemini-flash-latest` alias, Google publishes no `-latest` alias for
# any image model. The old repo shipped `fix(gemini): replace retired image
# fallback model` once already.
GEMINI_IMAGE_FALLBACK_MODELS=gemini-2.5-flash-image

# Metricool — the only publishing integration. Owns the rival list and the
# page list; we mirror neither (ADR-0001).
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=

# X / Twitter — single tweet lookup via api.x.com/2
X_BEARER_TOKEN=
