# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/

# Local state — never committed
*.db
*.db-wal
*.db-shm
*.db.bak
# Every .env variant, not just the two names we happen to use today: a
# hand-made backup like .env.bak sits outside an exact-name rule and is
# committable, which is a key in the history.
.env
.env.*
# ...except the committed template, which carries no values.
!.env.example

# YouTube tool dev shim
api/.shorts-dev/
