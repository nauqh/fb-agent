# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/

# Local state — never committed
*.db
*.db-wal
*.db-shm
*.db.bak
# Every .env variant, not just the two names we happen to use today: a
# hand-made backup like .env.bak sits outside an exact-name rule and is
# committable, which is a key in the history.
.env
.env.*
# ...except the committed template, which carries no values.
!.env.example

# YouTube tool dev shim
api/.shorts-dev/

# A yt-dlp cookies export is a live Google session, not a config file. It lands
# here on the way to YTDLP_COOKIES_B64 and should be deleted after encoding —
# this is the guard for the times it is not. The old repo kept the same line
# (social-agent .gitignore, `/secrets/youtube-cookies.txt`).
cookies.txt
*.cookies.txt
