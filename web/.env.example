# Copy to .env.local and fill in. .env.local is gitignored.

# The same value as API_KEY in the API's .env and in Railway's variables.
# src/proxy.ts attaches it to every proxied request, server-side.
#
# Deliberately not NEXT_PUBLIC_API_KEY: that prefix inlines a value into the
# client bundle at build time, which would hand the key to every visitor.
API_KEY=

# Where /api/* is proxied. Defaults to http://127.0.0.1:8000 — set this to the
# Railway URL to drive the deployed API from a local web server.
#
# 127.0.0.1 rather than localhost: on Windows localhost resolves to ::1 first
# while uvicorn binds IPv4, and the mismatch reads as ECONNREFUSED against a
# server that is plainly running.
API_ORIGIN=http://127.0.0.1:8000

# The operator's sign-in. Checked in src/app/auth/login/route.ts against what
# the form posted; neither value reaches the browser.
APP_EMAIL=
APP_PASSWORD=

# Signs the session cookie. Any long random string — `openssl rand -base64 32`.
# Blank denies every session rather than accepting every one.
AUTH_SECRET=
